# Copy to .env for Docker Compose. Keep keys on the server.
AGRIRAG_ENABLE_DEMOS=0
AGRIRAG_EVIDENCE_MODE=chroma
AGRIRAG_DATA_DIR=./data
GEMINI_API_KEY=
AGRIRAG_GEMINI_MODEL=gemini-3.1-flash-lite
OPENAI_API_KEY=
AGRIRAG_OPENAI_MODEL=gpt-4.1-mini
AGRIRAG_LIVE_WEATHER=1
OPEN_METEO_API_KEY=
AGRIRAG_ADMIN_PASSWORD=
